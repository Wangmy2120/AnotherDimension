# Server-side only. Never expose these values to the browser.
# For local dev/preview you can also configure AI in Settings; that entry is
# stored server-side in ~/.tianji/ai-config.json and never returned to the browser.
TIANJI_AI_BASE_URL=https://api.deepseek.com
TIANJI_AI_API_KEY=
TIANJI_AI_MODEL=deepseek-chat
